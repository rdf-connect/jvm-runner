@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sds: <https://w3id.org/sds#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.

sds:implementationOf rdfs:subPropertyOf rdfs:subClassOf.
rdfc:javaImplementationOf rdfs:subPropertyOf sds:implementationOf.
#
rdfc:JvmRunner a rdfc:Runner;
  rdfc:handlesSubjectsOf rdfc:javaImplementationOf;
  rdfc:command "[ -f jvm-runner.jar ] || curl -L -o jvm-runner.jar https://javadoc.jitpack.io/com/github/rdf-connect/jvm-runner/runner/master-SNAPSHOT/runner-master-SNAPSHOT-all.jar; java -jar jvm-runner.jar";
  rdfc:processor_definition <JavaProcessorShape>.

[ ] a sh:NodeShape;
  sh:targetSubjectsOf rdfc:javaImplementationOf;
  sh:property <#jar>, <#class>.

# A processor gives its jar as an IRI relative to its own definition rather than
# as a string literal, so the datatype below is advisory: it tells the extraction
# step to hand the value over as a string, and is not a claim about the term. The
# annotation marks that one constraint as a warning and leaves sh:minCount fatal,
# following SHACL 1.2 Core, section 3.1.4.
#
# These property shapes are named rather than blank because an annotation cannot
# currently be written inside a blank node property list.
<#jar> sh:path rdfc:jar;
  sh:name "jar";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string {| sh:severity sh:Warning |} .

<#class> sh:path rdfc:class;
  sh:name "clazz";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string.

